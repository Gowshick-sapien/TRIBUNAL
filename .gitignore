# ==========================================
# TRIBUNAL — Official Repository .gitignore
# ==========================================

# 1. Environment & Configuration
.env
.env.local
.env.*.local
.venv/
venv/
ENV/
env/

# 2. Python Bytecode & Test/Lint Caches
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# 3. Node.js & React Dashboard Artifacts
node_modules/
dashboard/node_modules/
dashboard/dist/
dashboard/dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 4. Phase D.2 Persistent Storage & SQLite Databases
*.db
*.db-journal
*.db-wal
*.sqlite
*.sqlite3
storage/tribunal.db
storage/files/reports/*
storage/files/graphs/*
storage/files/cases/*
storage/files/audit/*

# 5. IDE, OS & Editor Artifacts
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db
.system_generated/
.agents/

# 6. Logs, Export Files & Temporary Scratch Files
*.log
*.tmp
temp/
scratch/
tribunal_search_results.csv
tribunal_search_results.json
evidence_graph_*.png

# 7. Datasets & Model Artifacts
tribunal/datasets/*.csv
tribunal/datasets/*.txt
tribunal/datasets/raw/
tribunal/datasets/processed/*.parquet
tribunal/datasets/processed/*.gpickle
tribunal/datasets/processed/*.pkl
tribunal/datasets/processed/report.md
tribunal/datasets/processed/report.html
tribunal/datasets/processed/report.json
tribunal/datasets/processed/*.json
tribunal/datasets/processed/*.html
*.gpickle
*.parquet

# 8. Git Structure Preserved via .gitkeep
!**/datasets/.gitkeep
!**/datasets/raw/.gitkeep
!**/datasets/processed/.gitkeep
!**/storage/files/.gitkeep
!**/storage/files/reports/.gitkeep
!**/storage/files/graphs/.gitkeep
!**/storage/files/cases/.gitkeep
!**/storage/files/audit/.gitkeep
